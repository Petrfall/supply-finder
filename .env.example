# Скопируй в .env и впиши ключ. Без ключей — демо-режим на seed-данных.

# Вариант A — Anthropic (нативный web search, приоритетный):
ANTHROPIC_API_KEY=

# Вариант B — OpenAI-совместимый эндпоинт (напр. apinet.cloud, gpt-4o):
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
